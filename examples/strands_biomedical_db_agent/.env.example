# Database endpoints / files
OPEN_TARGETS_GRAPHQL_URL=http://127.0.0.1:8081/api/v4/graphql
OPEN_TARGETS_EXPECTED_RELEASE=26.06
GWAS_CATALOG_SQL_DATA_ROOT=/path/to/gwas/2026-03-17

# OpenAI-compatible inference endpoints; model IDs must match the served models.
OPENTARGETS_MODEL_BASE_URL=http://model-host:8000/v1
OPENTARGETS_MODEL_ID=your-opentargets-model
OPENTARGETS_MODEL_API_KEY=EMPTY
GWAS_MODEL_BASE_URL=http://model-host:8001/v1
GWAS_MODEL_ID=your-gwas-model
GWAS_MODEL_API_KEY=EMPTY

# Qwen deployment settings; replace with settings supported by your model server.
OPENTARGETS_MODEL_SAMPLING_PARAMS={"max_tokens":8192,"temperature":0.7,"top_p":0.8,"presence_penalty":0,"extra_body":{"top_k":20,"chat_template_kwargs":{"enable_thinking":false}}}
GWAS_MODEL_SAMPLING_PARAMS={"max_tokens":8192,"temperature":0.7,"top_p":0.8,"presence_penalty":0,"extra_body":{"top_k":20,"chat_template_kwargs":{"enable_thinking":false}}}
DATABASE_AGENT_TURN_LIMIT=20
DATABASE_AGENT_TIMEOUT_SECONDS=600

# Optional: AWS region for S3 and AgentCore
AWS_REGION=us-west-2
