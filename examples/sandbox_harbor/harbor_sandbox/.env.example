# Copy this file to `.env` (git-ignored) and fill in your own deployment values,
# so the real account-specific identifiers never land in the committed repo.
# Loaded by harbor_sandbox/config.py and sourced by harness/build_push.sh.
# Format: one KEY=value per line, no inline comments (keeps the parser + shell
# `source` trivial); put any note on its own # line above the value.

REGION=us-west-2
# your AWS account id
ACCOUNT=123456789012
# bucket for rollout records + run outputs
S3_BUCKET=my-rollout-bucket
# runtime execution role name (lives in ACCOUNT)
ROLE_NAME=my-runtime-role
# ECR repo holding the harness images
HARNESS_REPO=my-harness-repo
