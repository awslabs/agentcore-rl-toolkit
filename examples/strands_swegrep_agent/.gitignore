.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
# generated by data/build_*.py
data/train.jsonl
data/val.jsonl
data/window*/
data/benchmarks/
data/.cache/
# run outputs
runs/
evals/
exports/
logs/
# tracked configs and manifests (re-included when nested in a repo that ignores *.json / *.jsonl)
!cdk/cdk.json
!data/manifests/*.json
!data/manifests/*.jsonl
!endpoint/backend_config.json
!recipes/**/*.json
