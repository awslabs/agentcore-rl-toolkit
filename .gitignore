# Virtual environments
.venv/
.venv-*/

# Python cache
__pycache__/
.ruff_cache/

# Build artifacts
*.egg-info/
dist/
build/

# Environment variables
.env
.wandb.env

# Logs and experiment tracking
wandb/
*.log
*.jsonl

# Local backend config (contains ARN/bucket; commit config.yaml.example only).
# Covers backends/slime and backends/experimental/*.
src/agentcore_rl_toolkit/backends/**/examples/**/config.yaml

# Training/example run artifacts, wherever generated. Convention-level patterns:
# hydra run dirs, verl checkpoint dirs (scripts use CKPTS_DIR=exp_*), wandb run
# dirs, and generated datasets (reproducible via the example preprocess scripts).
outputs/
checkpoints/
exp_*/
wandb/
*.parquet

# Config files
config.toml

# Claude Code configuration: ignore everything by default,
# allowlist only skills meant to ship with the repo.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/check-cloudwatch-session-logs/
# Personal per-project Claude instructions (loaded alongside CLAUDE.md, never committed)
CLAUDE.local.md

.bedrock_agentcore.yaml
