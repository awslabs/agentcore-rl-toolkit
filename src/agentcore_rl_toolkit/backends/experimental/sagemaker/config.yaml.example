# GRPO training — rollout gateway + SageMaker Training Sessions

# --- AWS resources (required) ---
role_arn: "arn:aws:iam::<account-id>:role/<your-sagemaker-role>"
s3_output_path: "s3://<your-s3-bucket>/output/" # S3 to store model checkpoints
model_package_group_arn: "arn:aws:sagemaker:<region>:<account-id>:model-package-group/<your-group>"
base_model_arn: "arn:aws:sagemaker:<region>:aws:hub-content/SageMakerPublicHub/Model/<model-name>"
agent_runtime_arn: "arn:aws:bedrock-agentcore:<region>:<account-id>:runtime/<your-agent-id>" # an AgentCoreRuntimeApp agent, e.g. examples/strands_math_agent/rl_app.py

region: "us-east-1"

# --- LoRA ---
lora_rank: 32
lora_alpha: 64
resume_from_model_package: ""

# --- Training ---
batch_size: 32
responses_per_prompt: 4
learning_rate: 1.0e-5
max_context_tokens: 32768
max_new_tokens: 8192
temperature: 1.0
epochs: 1
loss: ppo          # ppo | importance_sampling | cispo

# --- Dataset ---
dataset_path: "/path/to/train.parquet"
max_prompts: 0     # 0 = use all

# --- Evaluation ---
eval_dataset_path: "/path/to/test.parquet"
eval_every: 10     # 0 = only at end
eval_max_prompts: 0
eval_temperature: 0.0

# --- Gateway ---
gateway_port: 0    # 0 = OS-assigned
history_mode: linear # tree | linear | tree_healed (linear: one record per append-only rollout)
chat_template_kwargs: {enable_thinking: false}  # e.g. {enable_thinking: false}

# --- Checkpointing ---
save_every: -1     # -1 = only at end
save_weights_at_end: false
train_op_timeout: 600.0  # seconds per forward_backward / optim_step / save

# --- Rollout ---
max_rollout_time: 1800.0
acr_tps_limit: 5

# --- Logging ---
wandb_project: ""
wandb_run_name: ""  # defaults to the SageMaker training session name
