# Toolkit + slime backend settings for the rollout function.
# Copy to config.yaml (gitignored) and fill in your deployment values.
#
#   cp config.yaml.example config.yaml
#   # edit rollout_session_backend.agentcore_runtime_arn
#
# Passed to slime via --custom-config-path config.yaml.
# All keys become attributes on slime's args namespace.

# Rollout session class and its constructor kwargs, passed to
# agentcore_rl_toolkit.rollout_session.factory.make_session. The runtime is the
# ACR deployment of examples/strands_math_agent/runtime_app.py.
rollout_session_backend:
  backend: agentcore_rl_toolkit.rollout_session.agentcore_http_session.AgentCoreHttpSession
  agentcore_runtime_arn: "arn:aws:bedrock-agentcore:<region>:<account-id>:runtime/<runtime-name>-<id>"

# Toolkit tunables
gateway_port: 9090                  # rollout gateway port
max_rollout_time: 900               # per-session rollout timeout (s)
tps_limit: 5                        # new rollout sessions per second
