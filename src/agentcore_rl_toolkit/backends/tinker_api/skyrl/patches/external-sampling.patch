+        # (gzip=True writes level 0, framing only, for readers that require gzip).
+        mode, options = ("w:gz", {"compresslevel": 0}) if gzip else ("w", {})
+        destination = AnyPath(output_path)
+        with destination.open("wb") as f, tarfile.open(fileobj=f, mode=mode, **options) as tar:
