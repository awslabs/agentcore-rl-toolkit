# Instance type: trn2.48xlarge. Neuron runtime settings for qwen3.6-27b.yaml, sourced by
# ../../serve.sh. Values already set in the environment take precedence.
export NEURON_PLATFORM_TARGET_OVERRIDE="${NEURON_PLATFORM_TARGET_OVERRIDE:-trn2}"
export NEURON_LOGICAL_NC_CONFIG="${NEURON_LOGICAL_NC_CONFIG:-2}"
# TP8 x DP8 uses all 64 logical cores; lower data-parallel-size together with this.
export NEURON_VISIBLE_DEVICES="${NEURON_VISIBLE_DEVICES:-0-63}"
export NEURON_EXECUTION_BACKEND="${NEURON_EXECUTION_BACKEND:-lite}"
export TORCH_DEVICE_BACKEND_AUTOLOAD="${TORCH_DEVICE_BACKEND_AUTOLOAD:-0}"
export NEURON_SKIP_EFA_AFFINITY="${NEURON_SKIP_EFA_AFFINITY:-1}"
export NEURON_RT_DISABLE_EXECUTION_BARRIER="${NEURON_RT_DISABLE_EXECUTION_BARRIER:-0}"
export NEURON_RT_IO_RING_CACHE_SIZE="${NEURON_RT_IO_RING_CACHE_SIZE:-32}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-2}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-1}"
export VLLM_NEURON_KV_GMU_BUDGET_CAP_FRACTION="${VLLM_NEURON_KV_GMU_BUDGET_CAP_FRACTION:-0.30}"
export VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS="${VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS:-3600}"
export VLLM_NEURON_BARRIER_TIMEOUT="${VLLM_NEURON_BARRIER_TIMEOUT:-7200}"
export VLLM_NEURON_COMPILATION_TIMEOUT="${VLLM_NEURON_COMPILATION_TIMEOUT:-7200}"
export NEURON_LIBTORCH_PARALLEL_COMPILE_WORKERS="${NEURON_LIBTORCH_PARALLEL_COMPILE_WORKERS:-2}"
export VLLM_NEURON_DISABLE_PARALLEL_TRACE="${VLLM_NEURON_DISABLE_PARALLEL_TRACE:-1}"
