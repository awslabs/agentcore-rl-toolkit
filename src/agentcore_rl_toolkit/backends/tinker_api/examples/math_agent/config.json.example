{
  "endpoint": "http://GPU_NODE_PRIVATE_IP:18080",
  "base_model": "/models/Qwen3.5-4B",
  "tokenizer": "Qwen/Qwen3.5-4B",
  "chat_template_kwargs": {"enable_thinking": false},
  "dataset": "/path/to/gsm8k-train.jsonl",
  "evaluation_dataset": "/path/to/gsm8k-test.jsonl",
  "agent_runtime_arn": "arn:aws:bedrock-agentcore:us-west-2:ACCOUNT:runtime/RUNTIME_ID",
  "s3_bucket": "ROLLOUT_BUCKET",
  "gateway_host": "CPU_NODE_PRIVATE_IP",
  "gateway_port": 0,
  "history_mode": "linear",
  "output_dir": "/path/to/run-output",
  "steps": 116,
  "batch_size": 64,
  "group_size": 4,
  "tps_limit": 4,
  "rollout_timeout": 180,
  "evaluation_batch_size": 256,
  "evaluation_temperature": 0.6,
  "evaluation_interval": 10,
  "checkpoint_interval": 20,
  "lora_rank": 32,
  "learning_rate": 0.00001,
  "max_new_tokens": 2048,
  "max_context_tokens": 16384,
  "wandb_project": "agentcore_tinker"
}
